    "Accept-Language": "en-US,en;q=0.9",
}

# ... (rest of the imports)

cache = diskcache.Cache("/tmp/llm_websearch_cache")
logger = logging.getLogger(__name__)

def google_search(query, num_results=10, timeout=10):
