<file path="llm_websearch/__init__.py">
import os
import asyncio
import json
from typing import List, Dict
import click
import llm
import httpx
from dotenv import load_dotenv

load_dotenv()  # Load environment variables from .env file

class SearchError(Exception):
    """Custom exception for search-related errors."""
    pass

async def bing_search(query: str, num_results: int = 10, timeout: float = 30.0) -> List[Dict]:
    """
    Perform an asynchronous search using the Bing Search API.

    Args:
        query (str): The search query.
        num_results (int): The maximum number of results to return (default: 10).
        timeout (float): The timeout for the API request in seconds (default: 30.0).

    Returns:
        List[Dict]: A list of dictionaries containing search results.

    Raises:
        SearchError: If there's an error during the search process.
    """
    bing_api_key = os.getenv("BING_SEARCH_API_KEY") or os.getenv("BING_SUBSCRIPTION_KEY")
    if not bing_api_key:
        raise SearchError("Bing Search API key not found in environment variables.")

    endpoint = "https://api.bing.microsoft.com/v7.0/search"
    headers = {"Ocp-Apim-Subscription-Key": bing_api_key}
    params = {"q": query, "count": num_results}

    try:
        async with httpx.AsyncClient() as client:
            response = await client.get(endpoint, headers=headers, params=params, timeout=timeout)
            response.raise_for_status()
            search_results = response.json()
    except httpx.RequestError as e:
        raise SearchError(f"Error during Bing search request: {str(e)}")
    except json.JSONDecodeError:
        raise SearchError("Error decoding Bing search response")

    results = []
    for item in search_results.get("webPages", {}).get("value", []):
        results.append({
            "title": item.get("name", ""),
            "url": item.get("url", ""),
            "snippet": item.get("snippet", ""),
            "source": "bing"
        })

    return results[:num_results]

async def google_search(query: str, num_results: int = 10, timeout: float = 30.0) -> List[Dict]:
    """
    Perform an asynchronous search using the Google Custom Search JSON API.

    Args:
        query (str): The search query.
        num_results (int): The maximum number of results to return (default: 10).
        timeout (float): The timeout for the API request in seconds (default: 30.0).

    Returns:
        List[Dict]: A list of dictionaries containing search results.

    Raises:
        SearchError: If there's an error during the search process.
    """
    google_api_key = os.getenv("GOOGLE_SEARCH_API_KEY")
    google_cse_id = os.getenv("GOOGLE_CUSTOM_SEARCH_ENGINE_ID")
    if not google_api_key or not google_cse_id:
        raise SearchError("Google Search API key or Custom Search Engine ID not found in environment variables.")

    endpoint = "https://www.googleapis.com/customsearch/v1"
    params = {
        "key": google_api_key,
        "cx": google_cse_id,
        "q": query,
        "num": num_results
    }

    try:
        async with httpx.AsyncClient() as client:
            response = await client.get(endpoint, params=params, timeout=timeout)
            response.raise_for_status()
            search_results = response.json()
    except httpx.RequestError as e:
        raise SearchError(f"Error during Google search request: {str(e)}")
    except json.JSONDecodeError:
        raise SearchError("Error decoding Google search response")

    results = []
    for item in search_results.get("items", []):
        results.append({
            "title": item.get("title", ""),
            "url": item.get("link", ""),
            "snippet": item.get("snippet", ""),
            "source": "google"
        })

    return results[:num_results]

def _mock_search_results(query: str, num_results: int = 10) -> List[Dict]:
    """
    Generate mock search results when both Bing and Google searches fail.

    Args:
        query (str): The search query.
        num_results (int): The number of mock results to generate (default: 10).

    Returns:
        List[Dict]: A list of dictionaries containing mock search results.
    """
    results = []
    for i in range(num_results):
        results.append({
            "title": f"Mock Result {i+1} for '{query}'",
            "url": f"https://example.com/mock-result-{i+1}",
            "snippet": f"This is a mock search result {i+1} for the query: {query}",
            "source": "mock"
        })
    return results

async def search(query: str, num_results: int = 10, timeout: float = 30.0) -> List[Dict]:
    """
    Perform a web search using both Bing and Google APIs, with fallback mechanisms.

    Args:
        query (str): The search query.
        num_results (int): The maximum number of results to return (default: 10).
        timeout (float): The timeout for API requests in seconds (default: 30.0).

    Returns:
        List[Dict]: A list of dictionaries containing search results.

    Raises:
        SearchError: If all search attempts fail, including the mock fallback.
    """
    bing_results = google_results = []

    try:
        bing_results = await bing_search(query, num_results, timeout)
    except SearchError as e:
        click.echo(f"Bing search failed: {str(e)}", err=True)

    if not bing_results:
        try:
            google_results = await google_search(query, num_results, timeout)
        except SearchError as e:
            click.echo(f"Google search failed: {str(e)}", err=True)

    combined_results = bing_results + google_results

    if not combined_results:
        click.echo("Both Bing and Google searches failed. Using mock results.", err=True)
        combined_results = _mock_search_results(query, num_results)

    if not combined_results:
        raise SearchError("All search attempts failed, including mock results.")

    return combined_results[:num_results]

def deep_search(query: str, num_results: int = 10, timeout: float = 30.0) -> Dict:
    """
    Perform a deep search by calling the search function and formatting the results.

    Args:
        query (str): The search query.
        num_results (int): The maximum number of results to return (default: 10).
        timeout (float): The timeout for API requests in seconds (default: 30.0).

    Returns:
        Dict: A dictionary containing the query, results, and analysis.
    """
    results = asyncio.run(search(query, num_results, timeout))
    return {
        "query": query,
        "results": results,
        "analysis": "Coming soon"
    }

@llm.hookimpl
def register_commands(cli: click.Group):
    @cli.group()
    def websearch():
        """Web search commands using LLM"""
        pass

    @websearch.command()
    @click.argument("query", type=str)
    @click.option("-n", "--num-results", type=int, default=10, help="Number of results")
    @click.option("-t", "--timeout", type=float, default=30.0, help="Timeout in seconds")
    def search(query: str, num_results: int, timeout: float):
        """Perform a web search using Bing and Google APIs"""
        try:
            results = asyncio.run(search(query, num_results, timeout))
            click.echo(json.dumps(results, indent=2))
        except SearchError as e:
            click.echo(f"Search failed: {str(e)}", err=True)

    @websearch.command()
    @click.argument("query", type=str)
    @click.option("-n", "--num-results", type=int, default=10, help="Number of results")
    @click.option("-t", "--timeout", type=float, default=30.0, help="Timeout in seconds")
    def deep_search(query: str, num_results: int, timeout: float):
        """Perform a deep search with analysis (currently returns regular search results)"""
        try:
            results = deep_search(query, num_results, timeout)
            click.echo(json.dumps(results, indent=2))
        except SearchError as e:
            click.echo(f"Deep search failed: {str(e)}", err=True)

if __name__ == "__main__":
    load_dotenv()
</file>
