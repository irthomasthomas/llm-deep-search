<file path="tests/test_websearch.py">
import pytest
import asyncio
from unittest.mock import patch, MagicMock
from llm_websearch import bing_search, google_search, search, deep_search, SearchError

@pytest.mark.asyncio
async def test_bing_search():
    mock_response = MagicMock()
    mock_response.json.return_value = {
        "webPages": {
            "value": [
                {
                    "name": "Test Result",
                    "url": "https://example.com",
                    "snippet": "This is a test result"
                }
            ]
        }
    }

    with patch("httpx.AsyncClient.get", return_value=mock_response):
        results = await bing_search("test query")
        assert len(results) == 1
        assert results[0]["title"] == "Test Result"
        assert results[0]["url"] == "https://example.com"
        assert results[0]["snippet"] == "This is a test result"
        assert results[0]["source"] == "bing"

@pytest.mark.asyncio
async def test_google_search():
    mock_response = MagicMock()
    mock_response.json.return_value = {
        "items": [
            {
                "title": "Test Result",
                "link": "https://example.com",
                "snippet": "This is a test result"
            }
        ]
    }

    with patch("httpx.AsyncClient.get", return_value=mock_response):
        results = await google_search("test query")
        assert len(results) == 1
        assert results[0]["title"] == "Test Result"
        assert results[0]["url"] == "https://example.com"
        assert results[0]["snippet"] == "This is a test result"
        assert results[0]["source"] == "google"

@pytest.mark.asyncio
async def test_search_fallback():
    with patch("llm_websearch.bing_search", side_effect=SearchError), \
         patch("llm_websearch.google_search", side_effect=SearchError), \
         patch("llm_websearch._mock_search_results") as mock_results:
        
        mock_results.return_value = [
            {
                "title": "Mock Result",
                "url": "https://example.com/mock",
                "snippet": "This is a mock result",
                "source": "mock"
            }
        ]

        results = await search("test query")
        assert len(results) == 1
        assert results[0]["source"] == "mock"

def test_deep_search():
    with patch("llm_websearch.search") as mock_search:
        mock_search.return_value = [
            {
                "title": "Test Result",
                "url": "https://example.com",
                "snippet": "This is a test result",
                "source": "bing"
            }
        ]

        result = deep_search("test query")
        assert "query" in result
        assert "results" in result
        assert "analysis" in result
        assert result["query"] == "test query"
        assert len(result["results"]) == 1
        assert result["analysis"] == "Coming soon"

if __name__ == "__main__":
    pytest.main()
